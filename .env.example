# Copy to `.env` for local development, or set these as environment variables in
# your host (Railway → Variables). Never commit real secrets.

# MySQL connection string. On Railway, add a MySQL database and use the
# connection URL it provides. Format:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://user:password@localhost:3306/eatvera

# Secret used to sign session cookies (JWT). Use a long random string.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Anthropic API key — powers all AI food/photo analysis.
# Get one at https://console.anthropic.com/  (Settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use. Defaults to claude-opus-4-8.
# Set to a cheaper/faster model to reduce cost, e.g. claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-opus-4-8

# Optional: the email address that should be granted the "admin" role when it
# registers (access to the admin panel). Leave blank to make everyone a regular user.
# OWNER_EMAIL=you@example.com

# Set automatically by most hosts; only needed for local production runs.
# PORT=3000
